# Copy to /etc/drive-time-tracker.env on the VM and fill in values.
# chmod 600 /etc/drive-time-tracker.env

DATABASE_URL="file:/var/lib/drive-time-tracker/data/dev.db"

GOOGLE_MAPS_API_KEY=your-google-maps-api-key
CRON_SECRET=replace-with-long-random-secret
SITE_PASSWORD=replace-with-your-login-password

DEFAULT_TIMEZONE=America/Los_Angeles
ENABLE_BUILTIN_SCHEDULER=true
SCHEDULER_INTERVAL_MINUTES=5

# Required for production Next.js behind Caddy
HOSTNAME=0.0.0.0
PORT=3000
NODE_ENV=production
