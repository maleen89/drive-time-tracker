# SQLite for local dev. Use PostgreSQL in production, e.g.:
# DATABASE_URL="postgresql://user:pass@host:5432/drive_time_tracker"
DATABASE_URL="file:./dev.db"

# Required for scheduled route lookups (Routes API)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Optional: protects POST /api/cron/run for external schedulers (cloud deploy only)
CRON_SECRET=change-me-to-a-long-random-secret

# Default timezone for schedule slots (Bay Area)
DEFAULT_TIMEZONE=America/Los_Angeles

# PC local mode: check schedule slots every N minutes while npm run dev is running
ENABLE_BUILTIN_SCHEDULER=true
SCHEDULER_INTERVAL_MINUTES=5
