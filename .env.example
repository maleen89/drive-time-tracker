# SQLite for local dev. Use PostgreSQL in production, e.g.:
# DATABASE_URL="postgresql://user:pass@host:5432/drive_time_tracker"
DATABASE_URL="file:./dev.db"

# Required for scheduled route lookups (Routes API)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Optional: protects POST /api/cron/run (Bearer token). Required if using Cloud Scheduler.
CRON_SECRET=change-me-to-a-long-random-secret

# Production: browser login (HTTP Basic Auth). Leave empty for local dev without a password.
# SITE_PASSWORD=your-login-password

# Default timezone for schedule slots and display (Bay Area)
DEFAULT_TIMEZONE=America/Los_Angeles

# Built-in scheduler: runs while the Next.js server is up (npm run dev or npm start)
ENABLE_BUILTIN_SCHEDULER=true
SCHEDULER_INTERVAL_MINUTES=5
# Optional: how long after a slot time a run still counts as on-time (defaults to interval above)
# SCHEDULER_TOLERANCE_MINUTES=5
